select *
from layoffs;

create table layoffs_staged
like layoffs;

select *
from layoffs_staged;

insert layoffs_staged
select *
from layoffs;

select *
from layoffs_staged;

SELECT *, 
ROW_NUMBER() OVER (
PARTITION BY company, industry, total_laid_off, percentage_laid_off, `date`
) 
AS row_num
FROM layoffs_staged;

with duplicate_cte as 
(
select *, 
ROW_NUMBER() OVER (
PARTITION BY company, location, industry, total_laid_off, percentage_laid_off, `date`, stage, country, funds_raised_millions
)AS row_num
FROM layoffs_staged
)
select *
from duplicate_cte
where row_num > 1;

CREATE TABLE `layoffs_staged2` (
  `company` text,
  `location` text,
  `industry` text,
  `total_laid_off` int DEFAULT NULL,
  `percentage_laid_off` text,
  `date` text,
  `stage` text,
  `country` text,
  `funds_raised_millions` int DEFAULT NULL,
  `row_num` int
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

insert into layoffs_staged2
select *, 
ROW_NUMBER() OVER (
PARTITION BY company, location, industry, total_laid_off, percentage_laid_off, `date`, stage, country, funds_raised_millions
)AS row_num
FROM layoffs_staged;

select *
from layoffs_staged2
where row_num > 1;

delete 
from layoffs_staged2
where row_num > 1;

update layoffs_staged2
set company = trim(company);

select distinct industry
from layoffs_staged2
order by 1;

select distinct industry 
from layoffs_staged2
where industry like "crypto%";

select distinct country
from layoffs_staged2
order by 1;

update layoffs_staged2
set country = "United States"
where country like "United States%";

select `date`,
str_to_date(`date`, "%m/%d/%Y")
from layoffs_staged2;

update layoffs_staged2
set `date` = str_to_date(`date`, "%m/%d/%Y");

select `date`
from layoffs_staged2;

select *
from layoffs_staged2
where industry is null or industry = '';

update layoffs_staged2
set industry = null
where industry = '';

select t1.industry, t2.industry
from layoffs_staged2 t1
join layoffs_staged2 t2
on t1.company = t2.company
and t1.location = t2.location
where t1.industry is null 
and t2.industry is not null;

update layoffs_staged2 t1
join layoffs_staged2 t2
on t1.company = t2.company
and t1.location = t2.location
set t1.industry = t2.industry 
where t1.industry is null
and t2.industry is not null;

select *
from layoffs_staged2
where total_laid_off is null
and percentage_laid_off is null;

delete 
from layoffs_staged2
where total_laid_off is null
and percentage_laid_off is null;

select *
from layoffs_staged2;

alter table layoffs_staged2
drop column row_num;
