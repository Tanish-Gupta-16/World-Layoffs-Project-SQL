select *
from layoffs_staged2;

select max(total_laid_off), max(percentage_laid_off)
from layoffs_staged2;

select *
from layoffs_staged2
where percentage_laid_off = 1
order by total_laid_off desc;

select *
from layoffs_staged2
where percentage_laid_off = 1
order by funds_raised_millions desc;

select company, sum(total_laid_off)
from layoffs_staged2
group by company
order by 2 desc;

select min(`date`), max(`date`)
from layoffs_staged2;

select industry, sum(total_laid_off)
from layoffs_staged2
group by industry
order by 2 desc;

select country, sum(total_laid_off)
from layoffs_staged2
group by country
order by 2 desc;

select year (`date`), sum(total_laid_off)
from layoffs_staged2
group by year (`date`)
order by 1 desc;

select stage, sum(total_laid_off)
from layoffs_staged2
group by stage
order by 2 desc;

select substring(`date`,1,7) as `month`, sum(total_laid_off)
from layoffs_staged2
where substring(`date`,1,7) is not null
group by `month`
order by 1 asc;

with rolling_total as 
(select substring(`date`,1,7) as `month`, sum(total_laid_off) as monthly_laid_offs
from layoffs_staged2
where substring(`date`,1,7) is not null
group by `month`
order by 1 asc)
select `month`, monthly_laid_offs, sum(monthly_laid_offs) over(order by `month`) monthly_rolling_total
from rolling_total;

select company, year(`date`), sum(total_laid_off)
from layoffs_staged2
group by company, year(`date`)
order by 3 desc;

with Company_year (company, `year`, company_laid_offs) as 
(select company, year(`date`), sum(total_laid_off)
from layoffs_staged2
group by company, year(`date`)
)
select *, dense_rank() over(partition by `year` order by company_laid_offs desc) yearly_laid_off_ranking
from Company_year
where `year` is not null
order by yearly_laid_off_ranking;

with company_year_rankings as
(with Company_year (company, `year`, company_laid_offs) as 
(select company, year(`date`), sum(total_laid_off)
from layoffs_staged2
group by company, year(`date`)
)
select *, dense_rank() over(partition by `year` order by company_laid_offs desc) yearly_laid_off_ranking
from Company_year
where `year` is not null
order by yearly_laid_off_ranking)
select *
from company_year_rankings
where yearly_laid_off_ranking <= 5
order by `year`;
